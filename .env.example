# Copy to .env for local builds. On Vercel (git deploy), set EXPO_PUBLIC_* vars in
# Project Settings → Environment Variables — they are baked into the bundle at build time.
#
# Stripe secrets (STRIPE_SECRET_KEY, price IDs) belong in Supabase Edge Function secrets,
# NOT in Vercel — unless you only build locally.

# Required — your live Vercel URL (no trailing slash), e.g. https://foodprint.vercel.app
EXPO_PUBLIC_APP_URL=https://foodprint-pro.vercel.app

# Required — Supabase auth + data
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Food search (USDA)
EXPO_PUBLIC_FOOD_API_PROVIDER=usda
EXPO_PUBLIC_USDA_API_KEY=
EXPO_PUBLIC_FOOD_API_KEY=

# Optional — AI meal planner, AI chat, photo scan (add in Vercel dashboard too for GitHub deploys)
EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_OPENAI_API_KEY=

# Optional — Google sign-in (web OAuth client ID)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Optional — Stripe Checkout (publishable key only; secrets stay on Supabase)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase CLI / local scripts only (do NOT add to Netlify)
STRIPE_SECRET_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
